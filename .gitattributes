# Normalize line endings on commit, check out LF everywhere
* text=auto eol=lf

# Explicit text types
*.html   text
*.css    text
*.js     text
*.json   text
*.md     text
*.svg    text
*.txt    text

# Binary assets — never diff or normalize
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.avif   binary
*.ico    binary
*.mp4    binary
*.webm   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary

# GitHub linguist: keep language stats honest
*.min.js   linguist-vendored
*.min.css  linguist-vendored
